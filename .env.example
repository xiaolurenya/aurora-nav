# ===== NAS / Docker 部署环境变量（可选，全部有默认值）=====
# 服务端口（容器内固定 8787，此处改宿主机映射请改 docker-compose.yml）
PORT=8787
# 数据目录（务必挂载到宿主机持久化）
DATA_DIR=/app/data
# 会话签名密钥：留空则首次启动自动生成并写入数据文件，之后请保持不变
NAV_SECRET=
# 首次初始化的默认密码（仅首次生效，之后请在后台「安全设置」修改）
NAV_ADMIN_USER=admin
NAV_ADMIN_PASSWORD=admin123
NAV_VIEW_PASSWORD=123456
# 时区
TZ=Asia/Shanghai
